#!/bin/sh
# Add 1 to the patch of VERSION (vMAJOR.MINOR.PATCH) on every commit and copy it
# to README.md and docs/index.html. v1.0.1 -> v1.0.2 ... v1.0.9 -> v1.0.10.
# Turn on once per clone with: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
[ -f VERSION ] || exit 0
cur=$(tr -d ' \n\r' < VERSION)
if ! printf '%s' "$cur" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "pre-commit: VERSION must look like v1.0.1, got '$cur'" >&2; exit 1
fi
base=${cur%.*}; patch=${cur##*.}
new="$base.$((patch + 1))"
printf '%s\n' "$new" > VERSION
git add VERSION
if [ -f README.md ]; then
  sed -E -i.bak "s/^\*\*Version:\*\* v[0-9]+(\.[0-9]+)*$/**Version:** $new/" README.md && rm -f README.md.bak
  git add README.md
fi
if [ -f docs/index.html ]; then
  sed -E -i.bak "s#<span data-version>v[0-9.]+</span>#<span data-version>$new</span>#g" docs/index.html && rm -f docs/index.html.bak
  git add docs/index.html
fi
echo "pre-commit: version $cur -> $new"
